# Copy this file to .env and fill in real values. Never commit the real .env.

# --- AI (caption generation) ---
GEMINI_API_KEY=

# --- App ---
# Not currently used to sign anything, but give it a real random value if you
# wire up user sessions later. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=
UPLOAD_DIR=uploads
# Public URL this server is reachable at. Instagram's Graph API requires the
# uploaded video to be fetchable at a public URL, so this can't be localhost
# once you're posting to Instagram from a deployed server.
PUBLIC_BASE_URL=http://localhost:8000

# --- YouTube (Google Cloud OAuth client) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Meta (Instagram + Facebook) ---
# From your Meta App Dashboard → App settings → Basic.
META_APP_ID=
META_APP_SECRET=
# Only needed if you run get_access_token.py's standalone CLI flow.
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/auth/instagram/callback

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Twitter/X ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
